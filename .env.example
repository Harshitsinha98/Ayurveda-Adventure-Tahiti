# ---------------------------------------------------------------
# Ayurveda Tahiti – variables d'environnement
# Copier ce fichier en `.env` (local) ou les saisir dans Vercel.
# Ne jamais committer de vraies clés.
# ---------------------------------------------------------------

# Adresse publique du site (sans / final). Doit être définie AVANT le build
# (elle sert aussi à la protection CSRF de l'espace d'administration).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret Payload : longue chaîne aléatoire (ex. `openssl rand -hex 32`)
PAYLOAD_SECRET=change-me

# Base de données
#   Local  : fichier SQLite (aucune installation)
#   Prod   : PostgreSQL (Neon, région UE recommandée)
DATABASE_URI=file:./ayurveda.db
# DATABASE_URI=postgres://user:password@host/db?sslmode=require

# Images en production (Vercel Blob). Laisser vide en local.
BLOB_READ_WRITE_TOKEN=

# ---------------- Mobupay (paiement en ligne XPF) ----------------
# Espace marchand Mobupay → Développeur → Clés API.
# Test : sk_test_…   Production : sk_live_…
MOBUPAY_SECRET_KEY=
# Secret de signature des webhooks. Récupérable avec :
#   npm run mobupay:secret   (utilise MOBUPAY_SECRET_KEY)
# La clé test et la clé live ont chacune leur propre secret.
# Plusieurs secrets possibles, séparés par des virgules (endpoint enregistré + secret marchand).
MOBUPAY_WEBHOOK_SECRET=
# Optionnel (tests) : MOBUPAY_API_URL=https://api.mobupay.nc

# ---------------- Brevo (e-mails et newsletter) ------------------
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
EMAIL_FROM=eliane@ayurveda-tahiti.com
EMAIL_FROM_NAME=Ayurveda Tahiti

# ---------------- Tâches planifiées (Vercel Cron) ----------------
# Protège /api/cron/bookings (rappels, expiration des paiements non finalisés)
CRON_SECRET=change-me-too
# Fréquence du cron en heures : 24 (Vercel Hobby, 1 fois par jour) ou 0.5 (Vercel Pro, toutes les 30 min)
CRON_INTERVAL_HOURS=24

# ---------------- Seed (contenu initial) -------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
